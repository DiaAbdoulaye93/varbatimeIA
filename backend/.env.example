# Copy to backend/.env and fill in. backend/.env is ignored by git.

# Anthropic API key (https://console.anthropic.com). Never commit the real value.
ANTHROPIC_API_KEY=

# Models per pipeline step (see IMPLEMENTATION.md §2)
EXTRACT_MODEL=claude-haiku-5-5
CLUSTER_MODEL=claude-sonnet-5-5
SYNTH_MODEL=claude-sonnet-5-5

# Local PostgreSQL 16 (psycopg v3 driver). A hosted URL such as Neon's
# postgresql://user:pw@host/db?sslmode=require is accepted as is.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/sat_verbatim
# Dedicated database for pytest, dropped and recreated by the test fixtures
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/sat_verbatim_test

# Indicative USD -> FCFA rate for the dashboard cost panel (set to the day's rate)
USD_TO_XOF=604

# Password asked by the browser for the whole app (empty = no password, local only).
# Always set it on a public deployment.
APP_USERNAME=sat
APP_PASSWORD=

LOG_LEVEL=INFO
